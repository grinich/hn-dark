{
  "manifest_version": 3,
  "name": "Hacker News Dark",
  "version": "0.0.1",
  "description": "Dark mode for Hacker News. Only the colors change — same layout, same Verdana. Follows your system appearance.",
  "homepage_url": "https://github.com/grinich/hn-dark",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://news.ycombinator.com/*"
      ],
      "css": [
        "hn-dark.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
